<% if flash[:notice] || flash[:alert] %>
  <% type = flash[:notice].present? ? :notice : :alert %>
  <% message = flash[type] %>
  <div class="fixed top-4 right-4 z-50 max-w-md w-full px-4 sm:left-auto sm:right-4" data-controller="notification" data-notification-auto-dismiss-value="5000" role="alert" tabindex="-1">
    <div class="rounded-xl bg-neutral-800 border border-neutral-600 shadow-xl flex items-start gap-3 p-4" data-notification-target="toast">
      <div class="flex-shrink-0">
        <% if type == :notice %>
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-500" aria-hidden="true">
            <svg class="h-5 w-5 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
          </span>
        <% else %>
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-red-500" aria-hidden="true">
            <svg class="h-5 w-5 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
            </svg>
          </span>
        <% end %>
      </div>
      <div class="flex-1 min-w-0 pt-0.5">
        <p class="text-sm font-semibold text-white"><%= message %></p>
        <p class="mt-0.5 text-sm text-neutral-400"><%= type == :notice ? "Your action completed successfully." : "Please check and try again." %></p>
      </div>
      <button type="button" class="flex-shrink-0 rounded-lg p-1.5 text-neutral-400 hover:bg-neutral-700 hover:text-white transition focus:outline-none focus:ring-2 focus:ring-zumex-orange focus:ring-offset-2 focus:ring-offset-neutral-800" data-action="click->notification#dismiss" aria-label="Dismiss">
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </button>
    </div>
  </div>
<% end %>
